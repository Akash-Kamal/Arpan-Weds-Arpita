# Wedding Website Environment Variables (Optional Integrations)

# 1. Supabase Cloud Database & Storage (Project: cfqfnqxtillxgazjkwlx)
# Found under: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://cfqfnqxtillxgazjkwlx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Server-only secrets (Never expose to client / never prefix with NEXT_PUBLIC_)
SUPABASE_URL=https://cfqfnqxtillxgazjkwlx.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Optional: Host admin master secret to moderate/delete any photo from the admin view
ADMIN_SECRET_KEY=your_optional_admin_secret_key

# 2. Email Notifications for RSVP Submissions
# Set the email where you want all guest RSVP details to be delivered:
RSVP_NOTIFICATION_EMAIL=your_email@gmail.com

# Choose ANY of the following email methods:

# Method A: Gmail / SMTP (Recommended - 100% Free)
# For Gmail: create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_gmail_app_password

# Method B: Resend (Alternative modern email API)
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM_EMAIL=Arpan & Arpita Wedding <onboarding@resend.dev>

# Method C: EmailJS
# EMAILJS_SERVICE_ID=your_service_id
# EMAILJS_TEMPLATE_ID=your_template_id
# EMAILJS_PUBLIC_KEY=your_public_key
# EMAILJS_PRIVATE_KEY=your_private_key

# 3. WhatsApp RSVP Target Phone Number (Digits with country code, e.g. 919876543210)
NEXT_PUBLIC_RSVP_WHATSAPP_NUMBER=919876543210
